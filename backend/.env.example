PORT=5000
# Replace with your MongoDB Atlas Free Tier Cluster connection string:
MONGO_URI=mongodb+srv://admin:password@cluster0.mongodb.net/projectbuddy?retryWrites=true&w=majority
CLIENT_URL=http://localhost:3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Credentials (Google Cloud Console -> APIs & Services -> Credentials):
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Verification & OTP Service (e.g. Gmail App Password or custom SMTP)
# For Gmail: Use your Gmail address and generate a 16-character App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM=no-reply@projectbuddy.dev
# Optional custom SMTP host (leave empty if using Gmail):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
