# Root Git Ignore for ProjectBuddy

# Dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment and Secret Files (Strictly Protect Secrets)
**/.env
**/.env*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
*.pem
*.key
*.cert

# Allow environment template examples
!**/.env.example

# Next.js & Build outputs
**/.next/
**/out/
**/build/
**/dist/
**/coverage/

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pnpm-debug.log*
*.log

# Vercel & Deployments
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS & Temp
.DS_Store
Thumbs.db
